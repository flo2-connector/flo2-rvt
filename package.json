{
  "name": "flo2-rvt",
  "version": "0.4.0",
  "private": true,
  "description": "An MCP server that lets an agent working through flo2.io have real Revit, in Autodesk's cloud (APS Design Automation v3), read a person's .rvt model, and edit it into a new one through a fixed vocabulary of changes.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "server/src/index.ts",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "flo2-rvt": "scripts/flo2-rvt.ts"
  },
  "scripts": {
    "start": "node server/src/index.ts",
    "test": "node --test --test-concurrency=1 \"server/test/*.test.ts\" \"scripts/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "gen": "node scripts/gen-types.ts",
    "gen:check": "node scripts/gen-types.ts --check",
    "flo2-rvt": "node scripts/flo2-rvt.ts",
    "deps": "node scripts/dependency-currency.ts",
    "watch:autodesk": "node scripts/autodesk-watch.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
